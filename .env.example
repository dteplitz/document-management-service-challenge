# =============================================================================
# Document Management Service — environment variables template
# =============================================================================
# Copy this file to .env and fill in real values. .env is gitignored.
#   cp .env.example .env
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
# Superuser for the challenge database (official postgres:15 image).
# These credentials are used ONLY by the init scripts to bootstrap the
# application role — the app itself connects as document_user (APP_DB_PASSWORD).
POSTGRES_USER=challenge_admin
POSTGRES_PASSWORD=change_me_admin_password
# Password assigned to the app user (document_user) by 00-create-app-user.sh.
# The application connects with this password.
APP_DB_PASSWORD=change_me_app_password

# --- MinIO root credentials (ADMIN ONLY) --------------------------------------
# Used exclusively by the minio-bootstrap init container to create the bucket
# and provision the application service account. The Java application itself
# NEVER uses these credentials at runtime.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio_password

# --- MinIO application service account ---------------------------------------
# Dedicated credentials used by the Java client. Provisioned automatically by
# the minio-bootstrap init container on first boot. Following the guidance in
# docs/minio-local-setup.md, the app does not use root credentials.
# Constraints: access key 3-20 alphanumeric chars; secret key 8-40 chars.
MINIO_APP_ACCESS_KEY=change_me_app_access_key
MINIO_APP_SECRET_KEY=change_me_app_secret_key
