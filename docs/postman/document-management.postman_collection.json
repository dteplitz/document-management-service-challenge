{
  "info": {
    "_postman_id": "d3c1a2b4-e5f6-7890-abcd-ef1234567890",
    "name": "Document Management Service",
    "description": "Validates the three endpoints of the document management service:\nUpload, Search, and Download.\n\nPrerequisites:\n1. Stack running: docker compose up --build\n2. Set the 'testPdfPath' collection variable to the absolute path of\n   docs/test-assets/test-document.pdf (included in the repo).\n\nRun order: execute folders in order (1 → 2 → 3). The Upload request\nstores the document ID automatically for use in Search and Download.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "Base URL of the running service"
    },
    {
      "key": "testPdfPath",
      "value": "",
      "type": "string",
      "description": "Absolute path to a PDF file for upload tests. Use docs/test-assets/test-document.pdf from the repo."
    },
    {
      "key": "documentId",
      "value": "",
      "type": "string",
      "description": "Populated automatically by the Upload request. Used in Download requests."
    },
    {
      "key": "presignedUrl",
      "value": "",
      "type": "string",
      "description": "Populated automatically by the Download request."
    },
    {
      "key": "uploadUser",
      "value": "postman-test-user",
      "type": "string"
    },
    {
      "key": "uploadName",
      "value": "postman-test-document.pdf",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Upload",
      "description": "Upload endpoint: POST /document-management/upload\nAccepts multipart/form-data with a JSON metadata part and a PDF file part.\nHandles files up to 500MB with a JVM heap capped at 50MB (streaming).",
      "item": [
        {
          "name": "Upload document — happy path (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('Location header points to download endpoint', () => {",
                  "    const location = pm.response.headers.get('Location');",
                  "    pm.expect(location).to.match(/\\/document-management\\/download\\/\\d+/);",
                  "    const id = location.split('/').pop();",
                  "    pm.collectionVariables.set('documentId', id);",
                  "    console.log('documentId saved:', id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "metadata",
                  "value": "{\"user\":\"{{uploadUser}}\",\"name\":\"{{uploadName}}\",\"tags\":[\"postman\",\"evidence\"]}",
                  "contentType": "application/json",
                  "type": "text",
                  "description": "Document metadata as JSON"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": null,
                  "contentType": "application/pdf",
                  "description": "PDF file to upload. Set testPdfPath variable to absolute path of docs/test-assets/test-document.pdf"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/document-management/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "document-management",
                "upload"
              ]
            }
          }
        },
        {
          "name": "Upload duplicate — same user+name (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 409 Conflict', () => pm.response.to.have.status(409));",
                  "",
                  "pm.test('Error code is DUPLICATE_DOCUMENT', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('code');",
                  "    pm.expect(body.code).to.equal('DUPLICATE_DOCUMENT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "metadata",
                  "value": "{\"user\":\"{{uploadUser}}\",\"name\":\"{{uploadName}}\",\"tags\":[\"duplicate\"]}",
                  "contentType": "application/json",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": null,
                  "contentType": "application/pdf"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/document-management/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "document-management",
                "upload"
              ]
            }
          }
        },
        {
          "name": "Upload missing required field — no user (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
                  "",
                  "pm.test('Error code is VALIDATION_FAILED', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.equal('VALIDATION_FAILED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "metadata",
                  "value": "{\"name\":\"missing-user.pdf\",\"tags\":[\"test\"]}",
                  "contentType": "application/json",
                  "type": "text",
                  "description": "Omits the required 'user' field"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": null,
                  "contentType": "application/pdf"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/document-management/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "document-management",
                "upload"
              ]
            }
          }
        },
        {
          "name": "Upload missing file part (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "metadata",
                  "value": "{\"user\":\"{{uploadUser}}\",\"name\":\"no-file.pdf\",\"tags\":[\"test\"]}",
                  "contentType": "application/json",
                  "type": "text",
                  "description": "Sends metadata only, no file part"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/document-management/upload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "document-management",
                "upload"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Search",
      "description": "Search endpoint: POST /document-management/search\nAccepts optional filters (user, name, tags) in the JSON body.\nSupports pagination via ?page=N&size=N query params.\nResults are ordered by createdAt DESC.\nMust NOT return download URLs.",
      "item": [
        {
          "name": "Search all documents (no filters)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Response shape: metadata + documents array', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('metadata');",
                  "    pm.expect(body).to.have.property('documents');",
                  "    pm.expect(body.documents).to.be.an('array');",
                  "    pm.expect(body.metadata).to.have.property('totalItems');",
                  "    pm.expect(body.metadata.totalItems).to.be.at.least(1);",
                  "});",
                  "",
                  "pm.test('No download URL in search response (spec requirement)', () => {",
                  "    const body = pm.response.json();",
                  "    body.documents.forEach(doc => {",
                  "        pm.expect(doc).to.not.have.property('url');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/document-management/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "document-management",
                "search"
              ]
            }
          }
        },
        {
          "name": "Search by user (exact match)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('All returned documents belong to the requested user', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.metadata.totalItems).to.be.at.least(1);",
                  "    body.documents.forEach(doc => {",
                  "        pm.expect(doc.user).to.equal(pm.collectionVariables.get('uploadUser'));",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"user\":\"{{uploadUser}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/document-management/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "document-management",
                "search"
              ]
            }
          }
        },
        {
          "name": "Search by tag",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('All returned documents contain the requested tag', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.metadata.totalItems).to.be.at.least(1);",
                  "    body.documents.forEach(doc => {",
                  "        pm.expect(doc.tags).to.include('postman');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"tags\":[\"postman\"]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/document-management/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "document-management",
                "search"
              ]
            }
          }
        },
        {
          "name": "Search by name (exact match)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Returns exactly 1 document with the given name', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.metadata.totalItems).to.equal(1);",
                  "    pm.expect(body.documents[0].name).to.equal(pm.collectionVariables.get('uploadName'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"{{uploadName}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/document-management/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "document-management",
                "search"
              ]
            }
          }
        },
        {
          "name": "Search with pagination (page=0, size=1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Pagination metadata is correct', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.metadata.currentPage).to.equal(0);",
                  "    pm.expect(body.metadata.itemsPerPage).to.equal(1);",
                  "    pm.expect(body.metadata.currentItems).to.equal(1);",
                  "    pm.expect(body.documents).to.have.lengthOf(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/document-management/search?page=0&size=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "document-management",
                "search"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "1"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Download",
      "description": "Download endpoint: GET /document-management/download/{id}\nReturns a pre-signed MinIO URL valid for 15 minutes.\nThe service never proxies file bytes — MinIO serves them directly.",
      "item": [
        {
          "name": "Get pre-signed download URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Response contains a pre-signed URL', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('url');",
                  "    pm.expect(body.url).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('presignedUrl', body.url);",
                  "});",
                  "",
                  "pm.test('URL points to MinIO, not to the service', () => {",
                  "    const url = pm.response.json().url;",
                  "    pm.expect(url).to.include('localhost:9000');",
                  "    pm.expect(url).to.not.include(':8080');",
                  "});",
                  "",
                  "pm.test('URL contains expected bucket and user path', () => {",
                  "    const url = pm.response.json().url;",
                  "    pm.expect(url).to.include('document-bucket');",
                  "    pm.expect(url).to.include(pm.collectionVariables.get('uploadUser'));",
                  "});",
                  "",
                  "// Verify the pre-signed URL is directly fetchable from MinIO",
                  "const presignedUrl = pm.response.json().url;",
                  "pm.sendRequest({ url: presignedUrl, method: 'GET' }, (err, res) => {",
                  "    pm.test('Pre-signed URL fetchable directly from MinIO (200)', () => {",
                  "        pm.expect(err).to.be.null;",
                  "        pm.expect(res).to.have.property('code', 200);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/document-management/download/{{documentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "document-management",
                "download",
                "{{documentId}}"
              ]
            }
          }
        },
        {
          "name": "Fetch file directly from MinIO (manual verification)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Requires presignedUrl to be set by the previous request.",
                  "const url = pm.collectionVariables.get('presignedUrl');",
                  "if (!url) { throw new Error('presignedUrl not set — run Get pre-signed URL first'); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK — MinIO serves the file directly', () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has non-zero Content-Length', () => {",
                  "    const contentLength = parseInt(pm.response.headers.get('Content-Length') || '0', 10);",
                  "    pm.expect(contentLength).to.be.greaterThan(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{presignedUrl}}"
            },
            "description": "Copy the URL from the pre-signed URL response and paste it here, or open it directly in a browser. The automated check runs inside the Get pre-signed URL test script above."
          }
        },
        {
          "name": "Download non-existent document (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));",
                  "",
                  "pm.test('Error code is DOCUMENT_NOT_FOUND', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.code).to.equal('DOCUMENT_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/document-management/download/999999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "document-management",
                "download",
                "999999999"
              ]
            }
          }
        }
      ]
    }
  ]
}